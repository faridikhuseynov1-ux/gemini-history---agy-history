#!/usr/bin/env python3
"""
SVG Icons CLI Wrapper
Команда: svg-icons [команда] [аргументы]
"""

import subprocess
import sys
import os

SKILL_DIR = os.path.expanduser("~/.gemini/skills/svg-icons/scripts")

def run_script(script, *args):
    cmd = [sys.executable, os.path.join(SKILL_DIR, script)] + list(args)
    subprocess.run(cmd)

def print_help():
    print("""
  svg-icons — Браузер SVG библиотек иконок

  Использование:
    svg-icons                        Показать все библиотеки
    svg-icons detect [путь]          Определить тип проекта
    svg-icons detect [путь] --json   Машиночитаемый вывод

  Примеры:
    svg-icons
    svg-icons detect .
    svg-icons detect /path/to/project
""")

def main():
    args = sys.argv[1:]

    if not args or args[0] in ("list", "show", ""):
        run_script("show_libraries.py")
    elif args[0] == "detect":
        path = args[1] if len(args) > 1 else "."
        extra = ["--json"] if "--json" in args else []
        run_script("detect_project.py", path, *extra)
    elif args[0] in ("help", "--help", "-h"):
        print_help()
    else:
        run_script("show_libraries.py")

if __name__ == "__main__":
    main()
